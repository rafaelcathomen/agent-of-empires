#!/usr/bin/env python3
"""agent-chat: inter-agent messaging for the aoe fleet.

Originally authored by Elia Raimondi (NVIDIA); vendored into the aoe repo as
fleet tooling. Licensed under the repository's top-level MIT license.

One agent asks another (addressed by aoe session title or id) a question and gets a
reply back, using a shared SQLite store plus `aoe send` as the wakeup doorbell.

  agent-chat ask "Agile Newton" "which restitution did you use for the G1 feet?"
  agent-chat inbox
  agent-chat reply <msg_id> "restitution = 0.4"

Storage:  $AGENT_CHAT_DB  or  ~/.local/share/agent-chat/mail.db
Identity: $AGENT_CHAT_ID ('id:title')  or  `aoe session current`  or  --from
"""
import argparse
import concurrent.futures as cf
import json
import os
import sqlite3
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone

DEFAULT_DB = os.path.expanduser("~/.local/share/agent-chat/mail.db")
POLL_INTERVAL = 2.0


# --------------------------------------------------------------------------- store
def db_path():
    return os.environ.get("AGENT_CHAT_DB", DEFAULT_DB)


def connect():
    path = db_path()
    # `or "."`: a bare-filename AGENT_CHAT_DB has an empty dirname.
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    conn = sqlite3.connect(path, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    # Concurrent `broadcast` workers race the one-time WAL switch, which raises
    # SQLITE_BUSY (busy_timeout does not cover a journal-mode change); retry
    # until one wins, after which WAL persists and the rest read it back.
    for _ in range(200):
        try:
            conn.execute("PRAGMA journal_mode=WAL")
            break
        except sqlite3.OperationalError as e:
            if "locked" not in str(e):
                raise
            time.sleep(0.05)
    else:
        # Falling through to the default rollback journal would serialize
        # readers; single ask/reply still works, so warn rather than fail.
        print("agent-chat: warning: could not enable WAL (database stayed "
              "locked); proceeding on the default journal.", file=sys.stderr)
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS messages (
            id             TEXT PRIMARY KEY,
            thread_id      TEXT NOT NULL,
            from_id        TEXT NOT NULL,
            from_title     TEXT NOT NULL,
            to_id          TEXT NOT NULL,
            to_title       TEXT NOT NULL,
            kind           TEXT NOT NULL,   -- 'question' | 'reply'
            in_reply_to    TEXT,
            body           TEXT NOT NULL,
            status         TEXT NOT NULL,   -- unread | read | answered | consumed
            created_at     TEXT NOT NULL,
            blocking_until REAL,            -- ask deadline (epoch); questions only
            asker_pid      INTEGER          -- pid of the blocking `ask`; liveness
        )
        """
    )
    # CREATE TABLE IF NOT EXISTS never alters an existing table, so a DB from a
    # build before asker_pid lacks the column and every insert would fail; add
    # it. A table_info check would be a TOCTOU race under concurrent broadcast
    # workers (all read it missing, all ALTER, the losers crash on "duplicate
    # column"), so ALTER unconditionally and treat "duplicate column" as
    # already-migrated, the same idempotence as the WAL retry above.
    try:
        conn.execute("ALTER TABLE messages ADD COLUMN asker_pid INTEGER")
    except sqlite3.OperationalError as e:
        if "duplicate column" not in str(e):
            raise
    conn.commit()
    return conn


def now_iso():
    # Millisecond precision; ORDER BY created_at, rowid keeps a same-instant
    # question and reply deterministically ordered.
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


# ------------------------------------------------------------------------- aoe glue
def die(msg, code=1):
    print(f"agent-chat: {msg}", file=sys.stderr)
    sys.exit(code)


AOE_JSON_TIMEOUT = 30.0


def aoe_json(args, timeout=AOE_JSON_TIMEOUT):
    label = "aoe " + " ".join(args)
    try:
        out = subprocess.run(["aoe", *args, "--json"], capture_output=True,
                             text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"`{label}` timed out after {timeout:g}s")
    if out.returncode != 0:
        raise RuntimeError(f"`{label}` failed: {out.stderr.strip()}")
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        # aoe emits plain text (e.g. "No sessions found") with a zero exit on an
        # empty profile, so a non-JSON body is not signalled by the exit code.
        raise RuntimeError(f"`{label}` did not return JSON: {out.stdout.strip()[:120]}")


def aoe_list():
    """Sessions in the active profile, dying cleanly if aoe can't be queried.

    Scoped to the active profile (not `--all`): the doorbell's `aoe send` is
    also profile-scoped, so resolving a recipient in another profile would find
    a session `aoe send` then can't wake. Cross-profile addressing is a separate
    feature that must thread the profile through to `aoe send -p`.
    """
    try:
        return aoe_json(["list"])
    except RuntimeError as e:
        die(str(e))


def self_identity():
    env = os.environ.get("AGENT_CHAT_ID")
    if env:
        sid, _, title = env.partition(":")
        return sid, (title or sid)
    try:
        d = aoe_json(["session", "current"])
    except Exception as e:  # noqa: BLE001
        die(f"can't determine current aoe session ({e}). "
            f"Set AGENT_CHAT_ID='<id>:<title>' or pass --from '<id>:<title>'.")
    return d["id"], d.get("session") or d.get("title") or d["id"]


def identity_from_args(args):
    spec = getattr(args, "from_", None)
    if spec:
        sid, _, title = spec.partition(":")
        return sid, (title or sid)
    return self_identity()


def _full_path(s):
    """`<group>/<title>` for a session, e.g. 'work/agile/newton'."""
    g = (s.get("group") or "").strip("/")
    return f"{g}/{s['title']}" if g else s["title"]


def _candidates(sessions):
    return "\n".join(f"    {_full_path(s)}  ({s['id'][:12]})" for s in sessions)


def resolve_recipient(spec):
    # explicit "id:title" bypasses the aoe lookup (power users + tests)
    if ":" in spec:
        sid, _, title = spec.partition(":")
        return sid, (title or sid)
    sessions = aoe_list()
    key = spec.strip("/")
    # Most-specific first: exact id, then folder path, then title, then fuzzy.
    # Folder-aware so two agents that share a title in different folders are
    # addressable as 'group/sub/title', and a bare title that collides across
    # folders errors with the full paths listed instead of guessing.
    preds = [
        ("by id", lambda s: s["id"] == spec),
        ("by full path", lambda s: _full_path(s) == key),
        ("by path suffix", lambda s: "/" in key and _full_path(s).endswith("/" + key)),
        ("by title", lambda s: s["title"].lower() == spec.lower()),
        ("by id prefix", lambda s: s["id"].startswith(spec)),
        ("by title substring", lambda s: spec.lower() in s["title"].lower()),
    ]
    for how, pred in preds:
        matches = [s for s in sessions if pred(s)]
        if len(matches) == 1:
            return matches[0]["id"], matches[0]["title"]
        if len(matches) > 1:
            die(f"'{spec}' is ambiguous ({how}). Use the full folder path or id:\n"
                f"{_candidates(matches)}")
    die(f"no aoe session matches '{spec}'. Known sessions:\n{_candidates(sessions)}")


# A reviving `aoe send` starts the recipient's tmux/agent (and container), which
# takes real time; the generous bound just stops a wedged start hanging forever.
DOORBELL_TIMEOUT = 90.0


def doorbell(to_id, text, enabled=True, revive=True):
    """Deliver via `aoe send`. Returns True if delivered. With revive=False, a
    stopped recipient makes `aoe send` fail loud -> returns False (caller skips)."""
    if not enabled:
        return True
    if os.environ.get("AGENT_CHAT_DOORBELL_FAIL"):  # test seam
        return False
    cmd = ["aoe", "send"] + ([] if revive else ["--no-revive"]) + [to_id, text]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True,
                             timeout=DOORBELL_TIMEOUT)
    except subprocess.TimeoutExpired:
        print(f"agent-chat: doorbell to {to_id} timed out after "
              f"{DOORBELL_TIMEOUT:g}s", file=sys.stderr)
        return False
    if out.returncode != 0:
        print(f"agent-chat: doorbell to {to_id} failed: {out.stderr.strip()}",
              file=sys.stderr)
        return False
    return True


def _insert(conn, **f):
    conn.execute(
        "INSERT INTO messages (id, thread_id, from_id, from_title, to_id, to_title, "
        "kind, in_reply_to, body, status, created_at, blocking_until, asker_pid) "
        "VALUES (:id,:thread_id,:from_id,:from_title,:to_id,:to_title,:kind,"
        ":in_reply_to,:body,:status,:created_at,:blocking_until,:asker_pid)",
        f,
    )


def _pid_alive(pid):
    """Whether the `agent-chat ask` process that posted a question is still
    running, i.e. still blocking-polling for its reply. A killed asker's pid is
    gone at once, so a later reply doorbells it instead of being lost.
    """
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, just not ours to signal
    except OSError:
        return False
    return True


def _find_reply(conn, qid):
    return conn.execute(
        "SELECT * FROM messages WHERE in_reply_to=? AND kind='reply' "
        "ORDER BY created_at, rowid LIMIT 1", (qid,)
    ).fetchone()


EXIT_ANSWERED = 0
EXIT_NO_ANSWER = 3  # pending (timed out) or skipped (undeliverable, --no-revive)


def _run_ask(from_id, from_title, to_id, to_title, question, timeout,
             thread_id=None, do_doorbell=True, revive=True):
    """Post one question, ring the doorbell, and block-poll for the reply.

    Self-contained (opens its own SQLite connection; WAL makes concurrent
    connections safe), so it can run in a thread pool for `broadcast`. Returns a
    result dict; never raises for a per-recipient outcome. status is one of
    answered | pending | skipped.
    """
    conn = connect()
    msg_id = uuid.uuid4().hex
    thread_id = thread_id or msg_id
    deadline = time.time() + timeout

    def result(status, reply_row=None):
        return {"to_id": to_id, "to_title": to_title, "status": status,
                "msg_id": msg_id, "thread_id": thread_id,
                "reply": reply_row["body"] if reply_row is not None else None,
                "reply_from": reply_row["from_title"] if reply_row is not None else None,
                "reply_id": reply_row["id"] if reply_row is not None else None}

    with conn:
        _insert(conn, id=msg_id, thread_id=thread_id, from_id=from_id,
                from_title=from_title, to_id=to_id, to_title=to_title, kind="question",
                in_reply_to=None, body=question, status="unread",
                created_at=now_iso(), blocking_until=deadline, asker_pid=os.getpid())
    text = (
        f"[agent-chat] New question from {from_title} ({from_id}).\n\n"
        f"{question}\n\n"
        f"To answer, run:\n  agent-chat reply {msg_id} \"<your answer>\"\n\n"
        f"(Another AI agent in the aoe fleet is asking you directly; "
        f"answer from your project's knowledge.)"
    )
    delivered = doorbell(to_id, text, enabled=do_doorbell, revive=revive)
    if not delivered and not revive:
        return result("skipped")

    # Poll (read-only) for the reply. On return this process exits, so a later
    # reply sees the asker's pid gone and doorbells it (the async fallback).
    while time.time() < deadline:
        row = _find_reply(conn, msg_id)
        if row:
            with conn:
                conn.execute("UPDATE messages SET status='consumed' WHERE id=?",
                             (row["id"],))
            return result("answered", row)
        time.sleep(POLL_INTERVAL)

    row = _find_reply(conn, msg_id)
    if row:
        with conn:
            conn.execute("UPDATE messages SET status='consumed' WHERE id=?", (row["id"],))
        return result("answered", row)
    return result("pending")


def _ask_json_obj(res, include_recipient=False):
    """Canonical per-ask JSON shape, shared by `ask --json` and `broadcast
    --json` so a single parser handles both. `reply_id`/`from` are present only
    when a reply arrived; broadcast adds `to_id`/`to_title` to name the recipient.
    """
    obj = {"status": res["status"], "msg_id": res["msg_id"],
           "thread_id": res["thread_id"], "reply": res["reply"]}
    if include_recipient:
        obj["to_id"], obj["to_title"] = res["to_id"], res["to_title"]
    if res["reply"] is not None:
        obj["reply_id"] = res["reply_id"]
        obj["from"] = res["reply_from"]
    return obj


def _render_ask(args, res):
    if args.json:
        print(json.dumps(_ask_json_obj(res)))
    elif res["status"] == "answered":
        print(f"\n--- reply from {res['reply_from']} ---\n{res['reply']}")
    elif res["status"] == "skipped":
        print(f"agent-chat: msg {res['msg_id'][:8]} not delivered (recipient not live, "
              f"--no-revive), skipped.", file=sys.stderr)
    else:
        print(f"agent-chat: no reply yet; msg {res['msg_id'][:8]} pending. The reply will "
              f"be delivered to you when it arrives (or run: agent-chat replies).",
              file=sys.stderr)
    return EXIT_ANSWERED if res["status"] == "answered" else EXIT_NO_ANSWER


# ------------------------------------------------------------------------- commands
def cmd_ask(args):
    from_id, from_title = identity_from_args(args)
    to_id, to_title = resolve_recipient(args.recipient)
    if not args.json:
        print(f"agent-chat: asked {to_title} (waiting up to {int(args.timeout)}s)...",
              file=sys.stderr)
    res = _run_ask(from_id, from_title, to_id, to_title, args.question, args.timeout,
                   args.thread, not args.no_doorbell, not args.no_revive)
    return _render_ask(args, res)


def cmd_broadcast(args):
    """Ask every agent under a folder/group subtree, concurrently."""
    from_id, from_title = identity_from_args(args)
    sessions = aoe_list()
    path = args.group.strip("/").rstrip("*").rstrip("/")
    targets = [s for s in sessions
               if ((s.get("group") or "").strip("/") == path
                   or (s.get("group") or "").strip("/").startswith(path + "/"))
               and s["id"] != from_id]  # never broadcast to self
    if not targets:
        die(f"no aoe sessions under group '{path}' (other than yourself)")
    if not args.json:
        print(f"agent-chat: broadcasting to {len(targets)} agents under '{path}' "
              f"(up to {int(args.timeout)}s)...", file=sys.stderr)
    workers = min(len(targets), args.max_parallel)
    results = []
    with cf.ThreadPoolExecutor(max_workers=workers) as ex:
        futs = [ex.submit(_run_ask, from_id, from_title, s["id"], s["title"],
                          args.question, args.timeout, None,
                          not args.no_doorbell, not args.no_revive) for s in targets]
        for fut in cf.as_completed(futs):
            results.append(fut.result())
    results.sort(key=lambda r: r["to_title"])
    if args.json:
        print(json.dumps([_ask_json_obj(r, include_recipient=True) for r in results],
                         indent=2))
    else:
        for r in results:
            print(f"\n── {r['to_title']}  [{r['status']}]")
            print(r["reply"] or f"   (no answer: {r['status']})")
    answered = sum(1 for r in results if r["status"] == "answered")
    print(f"agent-chat: {answered}/{len(results)} answered", file=sys.stderr)
    return EXIT_ANSWERED if answered == len(results) else EXIT_NO_ANSWER


def cmd_reply(args):
    conn = connect()
    from_id, from_title = identity_from_args(args)
    q = conn.execute(
        "SELECT * FROM messages WHERE (id=? OR id LIKE ?) AND kind='question'",
        (args.msg_id, args.msg_id + "%"),
    ).fetchone()
    if not q:
        die(f"no question with id '{args.msg_id}'")
    reply_id = uuid.uuid4().hex
    with conn:
        _insert(conn, id=reply_id, thread_id=q["thread_id"], from_id=from_id,
                from_title=from_title, to_id=q["from_id"], to_title=q["from_title"],
                kind="reply", in_reply_to=q["id"], body=args.answer, status="unread",
                created_at=now_iso(), blocking_until=None, asker_pid=None)
        conn.execute("UPDATE messages SET status='answered' WHERE id=?", (q["id"],))

    # Doorbell the asker unless it is still blocking-polling: its `ask` pid is
    # alive AND its deadline has not passed. Requiring both bounds PID reuse (a
    # recycled pid past the deadline no longer suppresses) and covers a timed-out
    # or killed asker (dead pid), so their replies are delivered.
    bu = q["blocking_until"]
    asker_blocking = _pid_alive(q["asker_pid"]) and bu is not None and bu > time.time()
    if not asker_blocking and not args.no_doorbell:
        short_q = (q["body"][:120] + "…") if len(q["body"]) > 120 else q["body"]
        doorbell(q["from_id"],
                 f"[agent-chat] Reply from {from_title} to your question:\n"
                 f"  Q: {short_q}\n  A: {args.answer}\n\n"
                 f"Full thread: agent-chat thread {q['thread_id']}")
    print(f"agent-chat: replied to {q['from_title']} (msg {reply_id[:8]}).",
          file=sys.stderr)
    return 0


def cmd_inbox(args):
    conn = connect()
    me_id, me_title = identity_from_args(args)
    rows = conn.execute(
        "SELECT * FROM messages WHERE to_id=? AND kind='question' AND status!='answered' "
        "ORDER BY created_at, rowid", (me_id,)).fetchall()
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return 0
    if not rows:
        print(f"agent-chat: inbox empty for {me_title}.")
        return 0
    print(f"agent-chat inbox for {me_title} ({len(rows)} open):")
    for r in rows:
        print(f"\n  [{r['id'][:8]}] from {r['from_title']}  ({r['created_at']})")
        print(f"      {r['body']}")
        print(f"      -> agent-chat reply {r['id'][:8]} \"<answer>\"")
    return 0


def cmd_replies(args):
    conn = connect()
    me_id, _ = identity_from_args(args)
    rows = conn.execute(
        "SELECT * FROM messages WHERE to_id=? AND kind='reply' AND status!='consumed' "
        "ORDER BY created_at, rowid", (me_id,)).fetchall()
    if args.json:
        print(json.dumps([dict(r) for r in rows], indent=2))
    elif not rows:
        print("agent-chat: no new replies.")
    else:
        for r in rows:
            print(f"\n--- reply from {r['from_title']}  ({r['created_at']}) ---")
            print(r["body"])
            print(f"(thread: agent-chat thread {r['thread_id']})")
    if not args.peek and rows:
        with conn:
            conn.executemany("UPDATE messages SET status='consumed' WHERE id=?",
                             [(r["id"],) for r in rows])
    return 0


def cmd_thread(args):
    conn = connect()
    tid = args.thread_id
    rows = conn.execute(
        "SELECT * FROM messages WHERE thread_id IN "
        "(SELECT thread_id FROM messages WHERE id=? OR id LIKE ? OR thread_id=? "
        "OR thread_id LIKE ?) ORDER BY created_at, rowid",
        (tid, tid + "%", tid, tid + "%")).fetchall()
    if not rows:
        die(f"no thread '{tid}'")
    print(f"thread {rows[0]['thread_id'][:8]}:")
    for r in rows:
        tag = "Q" if r["kind"] == "question" else "A"
        print(f"\n[{tag}] {r['from_title']} -> {r['to_title']}  ({r['created_at']})")
        print(f"    {r['body']}")
    return 0


def cmd_whoami(args):
    me_id, me_title = identity_from_args(args)
    print(f"id:    {me_id}")
    print(f"title: {me_title}")
    return 0


# ----------------------------------------------------------------------------- main
def main(argv=None):
    p = argparse.ArgumentParser(prog="agent-chat", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--from", dest="from_", metavar="ID[:TITLE]",
                   help="override self identity (testing / non-aoe shells)")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("ask", help="ask another agent and wait for a reply")
    a.add_argument("recipient", help="aoe session title or id (or 'id:title')")
    a.add_argument("question")
    a.add_argument("--timeout", type=float, default=120.0, help="seconds to block (default 120)")
    a.add_argument("--thread", default=None, help="attach to an existing thread id")
    a.add_argument("--json", action="store_true",
                   help="emit one JSON result object: {status,msg_id,thread_id,reply,...}")
    a.add_argument("--no-revive", action="store_true",
                   help="don't wake a stopped recipient; skip instead of reviving it")
    a.add_argument("--no-doorbell", action="store_true")
    a.set_defaults(func=cmd_ask)

    b = sub.add_parser("broadcast",
                       help="ask every agent in a folder/group subtree, concurrently")
    b.add_argument("group", help="group/folder path, e.g. 'work/agile' (matches the subtree)")
    b.add_argument("question")
    b.add_argument("--timeout", type=float, default=120.0,
                   help="seconds to block per recipient (default 120)")
    b.add_argument("--max-parallel", type=int, default=8)
    b.add_argument("--json", action="store_true",
                   help="emit a JSON array of per-recipient result objects")
    b.add_argument("--no-revive", action="store_true",
                   help="skip stopped recipients instead of reviving them")
    b.add_argument("--no-doorbell", action="store_true")
    b.set_defaults(func=cmd_broadcast)

    r = sub.add_parser("reply", help="reply to a question by msg id")
    r.add_argument("msg_id")
    r.add_argument("answer")
    r.add_argument("--no-doorbell", action="store_true")
    r.set_defaults(func=cmd_reply)

    i = sub.add_parser("inbox", help="list open questions addressed to me")
    i.add_argument("--json", action="store_true")
    i.set_defaults(func=cmd_inbox)

    rp = sub.add_parser("replies", help="show (and consume) replies to my questions")
    rp.add_argument("--json", action="store_true")
    rp.add_argument("--peek", action="store_true", help="don't mark replies consumed")
    rp.set_defaults(func=cmd_replies)

    t = sub.add_parser("thread", help="print a full conversation thread")
    t.add_argument("thread_id")
    t.set_defaults(func=cmd_thread)

    w = sub.add_parser("whoami", help="print resolved self identity")
    w.set_defaults(func=cmd_whoami)

    args = p.parse_args(argv)
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
